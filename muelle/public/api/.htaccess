# Todo /api/* entra por index.php; las librerías internas no se sirven nunca.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^_lib(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
<FilesMatch "^(?!index\.php$).*\.php$">
  Require all denied
</FilesMatch>
